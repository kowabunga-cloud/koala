{
  "name": "koala",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "api:fetch": "curl -fsSL \"https://raw.githubusercontent.com/kowabunga-cloud/openapi/refs/tags/v$npm_package_config_openapiVersion/openapi.yaml\" -o openapi/openapi.yaml",
    "api:generate": "orval",
    "api:update": "npm run api:fetch && npm run api:generate"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.68.0",
    "netmask": "^2.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query-devtools": "^5.106.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/netmask": "^2.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "msw": "^3.0.3",
    "orval": "^8.46.0",
    "oxlint": "^1.91.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "license": "Apache-2.0",
  "config": {
    "openapiVersion": "0.58.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
